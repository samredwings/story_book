# ═══════════════════════════════════════════════════════════════════════════════
# STORYBOOK STUDIO — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://storybook:storybook123@localhost:5432/image_video_storybook

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AWS S3 / MinIO ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1
AWS_S3_BUCKET=video-storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/video-storage

# ─── FREE TIER AI ─────────────────────────────────────────────────────────────
HUGGINGFACE_API_KEY=hf_your_free_huggingface_token

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Web browser (Next dev) — not used inside the APK
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
# Bind all interfaces so phones on LAN can reach the API
API_HOST=0.0.0.0
WEB_PORT=3000
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars!!
JWT_EXPIRE=7d
# Comma-separated. Capacitor origins (https://localhost, capacitor://localhost)
# are always allowed automatically by the API.
CORS_ORIGIN=http://localhost:3000,https://localhost,capacitor://localhost

# ─── Content Settings ─────────────────────────────────────────────────────────
ADULT_CONTENT_ALLOWED=true
UNRESTRICTED_MODE=true
CONTENT_FILTERING=none
REQUIRE_AGE_VERIFICATION=true
MIN_AGE=18

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# ─── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=s3
STORAGE_LOCAL_PATH=./uploads
# PUBLIC_API_URL=http://192.168.1.42:3001

# ─── Features ─────────────────────────────────────────────────────────────────
FEATURE_BATCH_PROCESSING=true
FEATURE_WEBHOOKS=true
FEATURE_AUDIT_LOG=true
