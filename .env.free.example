# ==========================================
# IMG-VDO Free Tier Environment Template
# ==========================================
# Copy this file to .env and fill in your own values.
# All services listed here have a free tier.

# --- Node Environment ---
NODE_ENV=production

# --- API Server ---
API_PORT=10000
API_HOST=0.0.0.0

# --- Database (Supabase) ---
# Get this from your Supabase project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection for migrations (port 5432)
DIRECT_URL="postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres"

# --- Redis (Upstash) ---
# Get this from your Upstash Redis database details
REDIS_URL="rediss://default:[password]@[host]:[port]"
# For BullMQ worker (same as above for inline mode)
REDIS_HOST=[host]
REDIS_PORT=[port]
REDIS_PASSWORD=[password]

# --- JWT Secret ---
# Generate a random 32+ character string
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# --- CORS Origins ---
# Add your Vercel web URL and local dev URL
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:3000

# --- HuggingFace (Video Generation) ---
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_PROVIDER=fal-ai
HF_MODEL=stable-video-diffusion

# --- Storage (Supabase S3-compatible) ---
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]
SUPABASE_STORAGE_BUCKET=media-assets

# --- Inline Worker (Free Tier Mode) ---
# Set to "true" to run the worker inside the API process on Render
RUN_WORKER_INLINE=true
WORKER_CONCURRENCY=1

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# --- Logging ---
LOG_LEVEL=info

# --- Trust Proxy (Render sets this) ---
TRUST_PROXY=1

# --- Body Parser Limit ---
BODY_LIMIT=10mb

# --- Auth & Private Mode ---
# ALLOW_REGISTRATION=false means no one can create accounts
ALLOW_REGISTRATION=false
# PRIVATE_MODE=true enables silent owner login in the APK
PRIVATE_MODE=true
# Owner account credentials (used by seed.ts and owner-login endpoint)
OWNER_EMAIL=owner@local
OWNER_PASSWORD=your-owner-password-here
OWNER_USERNAME=owner
# Shared secret between APK and API for silent login (not real security, but stops casual guessing)
PRIVATE_LOGIN_SECRET=your-secret-here
