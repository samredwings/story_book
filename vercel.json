{
  "buildCommand": "cd apps/web && npm run build",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/web packages/shared || exit 1",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://your-render-api-url.onrender.com/api/:path*" }
  ]
}
