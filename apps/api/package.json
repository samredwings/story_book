{
  "name": "@img-vdo/api",
  "version": "1.0.0",
  "description": "Backend API for Image-to-Video Storybook",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:unit:node": "node --experimental-strip-types src/__tests__/run-unit.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.709.0",
    "@img-vdo/video-generator": "*",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.0",
    "axios": "^1.7.0",
    "bullmq": "^6.3.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^4.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.0",
    "prisma": "^5.22.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0",
    "vitest": "^1.6.1"
  }
}
