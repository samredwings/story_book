# Copy to .env.production (gitignored). Required for APK builds (cap:sync).
#
# Android emulator → host machine API:
#   NEXT_PUBLIC_API_URL=http://10.0.2.2:3001
#
# Physical phone (same Wi‑Fi as your API machine):
#   NEXT_PUBLIC_API_URL=http://192.168.x.x:3001
#
# Production HTTPS API:
#   NEXT_PUBLIC_API_URL=https://api.yourdomain.com
#
# Do NOT use http://localhost:3001 inside an APK — localhost is the phone itself.
NEXT_PUBLIC_API_URL=http://10.0.2.2:3001
