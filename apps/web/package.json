{
  "name": "@img-vdo/web",
  "version": "1.0.0",
  "description": "Frontend for IMG-VDO Image-to-Video Storybook",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "cap:add": "cap add android",
    "cap:sync": "node scripts/cap-sync.mjs",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:apk:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "android:apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "build:lowmem": "NODE_OPTIONS=--max-old-space-size=2048 next build",
    "build:analyze": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "export": "npm run build",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "axios": "^1.7.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.10.0",
    "next": "^14.2.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.12.0",
    "react-quill": "^2.0.0",
    "recharts": "^2.12.0",
    "sonner": "^1.4.0",
    "tailwindcss": "^3.4.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.0",
    "quill": "^2.0.2",
    "vitest": "^1.6.1",
    "typescript": "^5.6.0"
  }
}
